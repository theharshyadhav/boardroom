# --- LLM provider ------------------------------------------------------
# Which provider to call for narrative generation (executive summary,
# boardroom, Q&A). Everything else in the app runs with zero LLM calls.
# Options: anthropic | groq | gemini | openrouter
LLM_PROVIDER=anthropic

# Only fill in the key for the provider you selected above.
# Without ANY key configured, the app runs fully functional with
# deterministic fallback narratives — nothing crashes or blocks a demo.
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Optional model overrides (sensible defaults are used if left blank)
ANTHROPIC_MODEL=claude-sonnet-4-6
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-1.5-flash
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- storage -------------------------------------------------------------
SQLITE_PATH=boardmind.db
DUCKDB_PATH=:memory:

# --- misc ------------------------------------------------------------------
DATA_SEED=20260822
CORS_ORIGINS=http://localhost:3000,https://boardroom-six-nu.vercel.app
# Vercel previews and custom HTTPS frontend domains are accepted by default.
CORS_ORIGIN_REGEX=^(https://.*\.vercel\.app|http://localhost(:\d+)?)$

# =============================================================================
# Google Cloud / agentic platform configuration
# =============================================================================
# Leave GOOGLE_CLOUD_PROJECT blank to run entirely in local fallback mode:
# events dispatch in-process instead of via Pub/Sub, and agent
# memory/registry/timeline data lives in an in-memory dict instead of
# Firestore. Nothing crashes — it's how `dev.sh` runs out of the box — but
# none of it survives a restart and it isn't the real autonomous platform.
# Set GOOGLE_CLOUD_PROJECT (and authenticate — see docker-compose.yml) to run
# against the genuine Firestore / Pub/Sub / Vertex AI services.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=1
GEMINI_MODEL=gemini-2.5-flash

FIRESTORE_DATABASE=(default)

PUBSUB_ENABLED=1
PUBSUB_TOPIC_PREFIX=boardmind
# The public HTTPS URL Cloud Scheduler and Pub/Sub push subscriptions call
# back into. On Cloud Run this is the service URL deploy/setup_gcp.sh reads
# back after deploying. Locally, Pub/Sub push cannot reach
# http://localhost:8000 directly — use a tunnel (e.g. `gcloud run services
# proxy` or ngrok) if you need to test real push delivery outside Cloud Run;
# otherwise local runs use the in-process fallback dispatcher automatically
# whenever GOOGLE_CLOUD_PROJECT is unset.
SERVICE_BASE_URL=http://localhost:8000

# Optional defense-in-depth shared secret checked on Scheduler-triggered
# endpoints, in addition to Cloud Run's own OIDC invoker check.
SCHEDULER_SHARED_SECRET=

EXEC_WATCH_ENABLED=1
EXEC_WATCH_INTERVAL_SECONDS=300

CLOUD_LOGGING_ENABLED=1

# Set to "1" once you've run `gcloud model-armor templates create ...`
# (see deploy/setup_gcp.sh) to enable Model Armor screening on top of the
# built-in heuristic prompt-injection/PII scanner in app/platform/security.py.
MODEL_ARMOR_ENABLED=0
